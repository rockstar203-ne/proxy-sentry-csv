<Window
    x:Class="ProxySentryCsv.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ProxySentryCsv.Models">

    <Grid
        x:Name="Root"
        Padding="14"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenCsvButton" Click="OpenCsv_Click" Content="Open CSV" />
                    <Button x:Name="ExportAdsButton" Click="ExportAds_Click" Content="Export ADS" />
                    <Button x:Name="ExportTxtButton" Click="ExportTxt_Click" Content="Export TXT" />
                    <Button x:Name="CheckAllButton" Click="CheckAll_Click" Content="Check all" />
                    <Button x:Name="SortButton" Content="Sort">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="SortBySpeed_Click" Text="By speed" />
                                <MenuFlyoutItem Click="SortByDocumentOrder_Click" Text="Document order" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ClearUsedButton" Click="ClearUsed_Click" Content="Clear used" />
                    <Button x:Name="CacheButton" Click="Cache_Click" Content="Cache: ..." />
                    <Button x:Name="CloseAllButton" Click="CloseAll_Click" Content="Close All" />
                    <Button x:Name="SettingsButton" Click="Settings_Click" Content="Settings" />
                    <Button x:Name="AboutButton" Click="About_Click" Content="About" />
                    <TextBlock
                        x:Name="SummaryText"
                        MinWidth="320"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No CSV loaded" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Sync" />
                    <Button x:Name="OpenSyncGroupButton" Click="OpenSyncGroup_Click" Content="Open sync group" />
                    <Button x:Name="StartSyncButton" Click="StartSync_Click" Content="Start sync" />
                    <Button x:Name="StopSyncButton" Click="StopSync_Click" Content="Stop sync" />
                    <Button x:Name="ApplyTargetUrlButton" Click="ApplyTargetUrl_Click" Content="Apply target URL" />
                    <Button x:Name="AlignSelectedButton" Click="AlignSelected_Click" Content="Align selected" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Click delay" />
                    <ComboBox
                        x:Name="SyncClickDelayBox"
                        MinWidth="142"
                        VerticalAlignment="Center"
                        SelectedValuePath="Tag"
                        SelectionChanged="SyncClickDelayBox_SelectionChanged">
                        <ComboBoxItem Content="Off" Tag="0" />
                        <ComboBoxItem Content="0.5 sec" Tag="500" />
                        <ComboBoxItem Content="1 sec" Tag="1000" />
                        <ComboBoxItem Content="2 sec" Tag="2000" />
                    </ComboBox>
                    <ComboBox
                        x:Name="SyncMonitorBox"
                        MinWidth="360"
                        DisplayMemberPath="DisplayName"
                        PlaceholderText="Sync monitor"
                        SelectionChanged="SyncMonitorBox_SelectionChanged" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="TargetUrlBox"
                Header="Target URL"
                Text="https://www.browserscan.net" />

            <TextBox
                Grid.Column="1"
                x:Name="SearchBox"
                Header="Search"
                PlaceholderText="Name or IP"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ListView
                    x:Name="ProxyListsView"
                    ItemsSource="{x:Bind ProxyLists, Mode=OneWay}"
                    SelectionChanged="ProxyListsView_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.Header>
                        <Grid Padding="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Lists" />
                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Count" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProxyListEntry">
                            <Grid
                                Padding="12,8"
                                ColumnSpacing="8"
                                RightTapped="ProxyListItem_RightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Count}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <ListView
                    x:Name="ProxyList"
                    MinWidth="1660"
                    ItemsSource="{x:Bind Proxies, Mode=OneWay}"
                    SelectionChanged="ProxyList_SelectionChanged"
                    SelectionMode="Extended">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#805B9DFF" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#995B9DFF" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#AA4C8DFF" />
                        <SolidColorBrush x:Key="ListViewItemRevealBackgroundSelected" Color="#805B9DFF" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="42" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid
                            MinWidth="1660"
                            Padding="10,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="114" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="242" />
                            </Grid.ColumnDefinitions>

                            <TextBlock FontWeight="SemiBold" Text="#" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Select" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Name" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Browser" />
                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Group" />
                            <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Proxy" />
                            <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Region" />
                            <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="Ping" />
                            <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="Resp" />
                            <TextBlock Grid.Column="9" FontWeight="SemiBold" Text="Used" />
                            <TextBlock Grid.Column="10" FontWeight="SemiBold" Text="Status" />
                            <TextBlock Grid.Column="11" FontWeight="SemiBold" Text="Favorite" />
                            <TextBlock Grid.Column="12" FontWeight="SemiBold" Text="Actions" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProxyEntry">
                            <Grid
                                MinWidth="1660"
                                Padding="10,6"
                                Background="{Binding RowBackground}"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="114" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="242" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ListNumber}" />
                                <Button
                                    Grid.Column="1"
                                    Width="34"
                                    Height="28"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding SyncSelectButtonBrush}"
                                    BorderBrush="{Binding SyncSelectBorderBrush}"
                                    BorderThickness="1"
                                    Click="SyncSelect_Click"
                                    CornerRadius="6"
                                    Foreground="White">
                                    <Viewbox Width="14" Height="14">
                                        <Path
                                            Data="M1,7 L5,11 L13,2"
                                            Opacity="{Binding SyncCheckOpacity}"
                                            Stroke="White"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2.6" />
                                    </Viewbox>
                                </Button>
                                <TextBox
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Name"
                                    Text="{Binding DisplayName, Mode=TwoWay}"
                                    TextChanged="ProxyName_TextChanged" />
                                <ComboBox
                                    Grid.Column="3"
                                    MinWidth="102"
                                    SelectedValue="{Binding BrowserProvider, Mode=TwoWay}"
                                    SelectedValuePath="Tag"
                                    SelectionChanged="ProxyBrowser_SelectionChanged">
                                    <ComboBoxItem Content="Chrome" Tag="chrome" />
                                    <ComboBoxItem Content="Jancy" Tag="jancy" />
                                    <ComboBoxItem Content="Edge" Tag="edge" />
                                    <ComboBoxItem Content="Firefox" Tag="firefox" />
                                </ComboBox>
                                <Border
                                    Grid.Column="4"
                                    Width="82"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{Binding SpeedBadgeBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding SpeedGroup}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    Text="{Binding ProxyDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding StandardProxy}" />
                                <TextBlock
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    Text="{Binding RegionText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{Binding PingText}" />
                                <TextBlock Grid.Column="8" VerticalAlignment="Center" Text="{Binding ResponseText}" />
                                <Border
                                    Grid.Column="9"
                                    Width="62"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{Binding UsedBadgeBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding UsedText}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="10"
                                    VerticalAlignment="Center"
                                    Text="{Binding Status}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="11"
                                    MinWidth="76"
                                    Background="{Binding FavoriteButtonBrush}"
                                    Click="FavoriteProxy_Click"
                                    Content="{Binding FavoriteButtonText}"
                                    Foreground="White" />
                                <StackPanel
                                    Grid.Column="12"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        MinWidth="70"
                                        Click="ClearProxyCache_Click"
                                        Content="Cache" />
                                    <Button
                                        MinWidth="76"
                                        Background="{Binding CopyButtonBrush}"
                                        Click="CopyProxy_Click"
                                        Content="{Binding CopyButtonText}"
                                        Foreground="White" />
                                    <Button
                                        MinWidth="70"
                                        Background="{Binding OpenButtonBrush}"
                                        Click="OpenProxy_Click"
                                        Content="{Binding OpenButtonText}"
                                        Foreground="{Binding OpenButtonForegroundBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="3"
            x:Name="LogBorder"
            Padding="10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="LogTitleText"
                    FontWeight="SemiBold"
                    Text="Log" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="LogText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ready"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
