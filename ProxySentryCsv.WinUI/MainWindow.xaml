<Window
    x:Class="ProxySentryCsv.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ProxySentryCsv.Models">

    <Grid
        x:Name="Root"
        Padding="14"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenCsvButton" Click="OpenCsv_Click" Content="Open CSV" />
                    <Button x:Name="ExportAdsButton" Click="ExportAds_Click" Content="Export ADS" />
                    <Button x:Name="ExportTxtButton" Click="ExportTxt_Click" Content="Export TXT" />
                    <Button x:Name="CheckAllButton" Click="CheckAll_Click" Content="Check all" />
                    <Button x:Name="SortSpeedButton" Click="SortSpeed_Click" Content="Sort speed" />
                    <Button x:Name="ClearUsedButton" Click="ClearUsed_Click" Content="Clear used" />
                    <Button x:Name="SettingsButton" Click="Settings_Click" Content="Settings" />
                    <TextBlock
                        x:Name="SummaryText"
                        MinWidth="320"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No CSV loaded" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Sync" />
                    <Button x:Name="OpenSyncGroupButton" Click="OpenSyncGroup_Click" Content="Open sync group" />
                    <Button x:Name="StartSyncButton" Click="StartSync_Click" Content="Start sync" />
                    <Button x:Name="StopSyncButton" Click="StopSync_Click" Content="Stop sync" />
                    <Button x:Name="AlignSelectedButton" Click="AlignSelected_Click" Content="Align selected" />
                    <ComboBox
                        x:Name="SyncMonitorBox"
                        MinWidth="360"
                        DisplayMemberPath="DisplayName"
                        PlaceholderText="Sync monitor"
                        SelectionChanged="SyncMonitorBox_SelectionChanged" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="TargetUrlBox"
                Header="Target URL"
                Text="https://www.browserscan.net" />

            <TextBox
                Grid.Column="1"
                x:Name="SearchBox"
                Header="Search"
                PlaceholderText="Name or IP"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ListView
                    x:Name="ProxyListsView"
                    ItemsSource="{x:Bind ProxyLists, Mode=OneWay}"
                    SelectionChanged="ProxyListsView_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.Header>
                        <Grid Padding="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Lists" />
                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Count" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProxyListEntry">
                            <Grid
                                Padding="12,8"
                                ColumnSpacing="8"
                                RightTapped="ProxyListItem_RightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Count}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <ListView
                    x:Name="ProxyList"
                    MinWidth="1520"
                    ItemsSource="{x:Bind Proxies, Mode=OneWay}"
                    SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="42" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid
                            MinWidth="1520"
                            Padding="10,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="114" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="370" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>

                            <TextBlock FontWeight="SemiBold" Text="Row" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Name" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Browser" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Group" />
                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Proxy" />
                            <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Ping" />
                            <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Resp" />
                            <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="Used" />
                            <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="Status" />
                            <TextBlock Grid.Column="9" FontWeight="SemiBold" Text="Favorite" />
                            <TextBlock Grid.Column="10" FontWeight="SemiBold" Text="Actions" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProxyEntry">
                            <Grid
                                MinWidth="1520"
                                Padding="10,6"
                                Background="{Binding RowBackground}"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="114" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="370" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="172" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center" Text="{Binding RowNumber}" />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Name"
                                    Text="{Binding DisplayName, Mode=TwoWay}"
                                    TextChanged="ProxyName_TextChanged" />
                                <ComboBox
                                    Grid.Column="2"
                                    MinWidth="102"
                                    SelectedValue="{Binding BrowserProvider, Mode=TwoWay}"
                                    SelectedValuePath="Tag"
                                    SelectionChanged="ProxyBrowser_SelectionChanged">
                                    <ComboBoxItem Content="Jancy" Tag="jancy" />
                                    <ComboBoxItem Content="Chrome" Tag="chrome" />
                                    <ComboBoxItem Content="Edge" Tag="edge" />
                                    <ComboBoxItem Content="Firefox" Tag="firefox" />
                                </ComboBox>
                                <Border
                                    Grid.Column="3"
                                    Width="82"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{Binding SpeedBadgeBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding SpeedGroup}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Text="{Binding StandardProxy}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding PingText}" />
                                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding ResponseText}" />
                                <Border
                                    Grid.Column="7"
                                    Width="62"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{Binding UsedBadgeBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding UsedText}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="8"
                                    VerticalAlignment="Center"
                                    Text="{Binding Status}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="9"
                                    MinWidth="76"
                                    Background="{Binding FavoriteButtonBrush}"
                                    Click="FavoriteProxy_Click"
                                    Content="{Binding FavoriteButtonText}"
                                    Foreground="White" />
                                <StackPanel
                                    Grid.Column="10"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        MinWidth="76"
                                        Background="{Binding CopyButtonBrush}"
                                        Click="CopyProxy_Click"
                                        Content="{Binding CopyButtonText}"
                                        Foreground="White" />
                                    <Button
                                        MinWidth="70"
                                        Background="{Binding OpenButtonBrush}"
                                        Click="OpenProxy_Click"
                                        Content="{Binding OpenButtonText}"
                                        Foreground="{Binding OpenButtonForegroundBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="3"
            x:Name="LogBorder"
            Padding="10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="LogTitleText"
                    FontWeight="SemiBold"
                    Text="Log" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="LogText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ready"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
